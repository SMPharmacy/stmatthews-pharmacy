# =============================================================================
# Environment variables for St Matthew's Pharmacy website
#
# These power the EPS nomination form, which emails the pharmacy via Resend.
# Set the REAL values in NETLIFY (Site configuration -> Environment variables),
# NOT in this folder — everything deployed here is publicly downloadable.
#
# This file is a template only. It contains NO real secrets and is safe to
# commit. A real ".env" (with the actual key) is git-ignored.
# =============================================================================

# REQUIRED — your Resend API key. Create one at https://resend.com (API Keys).
# Looks like: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# OPTIONAL — where nomination emails are delivered.
# Defaults to info@stmatthewspharmacy.co.uk if left unset.
NOMINATION_TO=

# OPTIONAL — the "from" address shown on nomination emails.
# Leave UNSET until stmatthewspharmacy.co.uk is verified in Resend; the site
# then uses Resend's shared test sender (onboarding@resend.dev).
# Once verified, set to e.g. noreply@stmatthewspharmacy.co.uk
NOMINATION_FROM=
